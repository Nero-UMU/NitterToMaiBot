{
  "manifest_version": 2,
  "id": "github.nero-umu.nitter-to-maibot",
  "version": "1.5.7",
  "name": "Nitter 推文转发",
  "description": "定期读取 Nitter 订阅账号的新推文，支持按 QQ 群独立订阅，并转发正文、图片和视频附件。",
  "author": {
    "name": "Nero-UMU",
    "url": "https://github.com/Nero-UMU"
  },
  "license": "GPL-3.0-or-later",
  "urls": {
    "repository": "https://github.com/Nero-UMU/NitterToMaiBot",
    "homepage": "https://github.com/Nero-UMU/NitterToMaiBot",
    "documentation": "https://github.com/Nero-UMU/NitterToMaiBot/blob/main/README.md",
    "issues": "https://github.com/Nero-UMU/NitterToMaiBot/issues"
  },
  "changelog": "CHANGELOG.md",
  "host_application": {
    "min_version": "1.1.4",
    "max_version": "1.99.99"
  },
  "sdk": {
    "min_version": "2.7.1",
    "max_version": "2.99.99"
  },
  "dependencies": [
    {
      "type": "python_package",
      "name": "tomlkit",
      "version_spec": ">=0.13.3,<1"
    }
  ],
  "capabilities": [
    "chat.open_session",
    "llm.generate",
    "send.custom",
    "send.forward",
    "send.image",
    "send.text"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": [
      "zh-CN"
    ]
  },
  "plugin_type": "integration",
  "display": {
    "icon": {
      "type": "lucide",
      "value": "rss",
      "background": "#15202B"
    }
  }
}
